# Copy to .env and fill in. .env is gitignored.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=reddy_finances
PORT=5500

# Production hostname. Used in confirmation emails, contract PDFs and
# the Firebase authDomain redirect. Set to https://yourdomain.com in
# any deployment. Must be localhost for OPEN_ADMIN to work.
APP_URL=http://localhost:5500

# Set to 'production' in any deployment. NODE_ENV=production is the
# signal for the server to default TRUST_PROXY to on (see below).
# NODE_ENV=production

# Email configuration (Gmail SMTP example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=reddyfinancialsinc@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=Reddy Finances <reddyfinancialsinc@gmail.com>

# ---------- Firebase Authentication (replaces Google OAuth) ----------
# 1) Create a project at https://console.firebase.google.com (e.g. "reddy-finances").
# 2) In Project settings -> Your apps -> Add web app. Copy:
#      FIREBASE_API_KEY      (Web API key)
#      FIREBASE_AUTH_DOMAIN  (e.g. reddy-finances.firebaseapp.com)
#      FIREBASE_PROJECT_ID
# 3) In Build -> Authentication -> Sign-in method, enable "Google".
# 4) In Authentication -> Settings -> Authorized domains, add
#      localhost and your live domain (e.g. yourdomain.com).
# 5) Project settings -> Service accounts -> Generate new private key.
#    Open the downloaded JSON and copy:
#      FIREBASE_CLIENT_EMAIL  ("client_email")
#      FIREBASE_PRIVATE_KEY   ("private_key" - keep the \n escapes)
# Note: the service-account private key is what lets the server verify
# sign-in tokens. Without it, authentication stays switched off.
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Any long random string used to sign the login session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------- Administrators ----------------------------
# Comma-separated Google account emails allowed into the admin dashboard.
# They sign in with the same Google button as customers; only these
# addresses get through. Leave this blank and the dashboard stays closed
# to everyone, which is the safe default.
ADMIN_EMAILS=you@example.com

# Admin email + password login (set by node server/setadminpw.js).
# These are written automatically by that script and do not need to be
# set by hand.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD_SALT=<hex>
# ADMIN_PASSWORD_HASH=<hex>

# ---------------------- LOCAL DEVELOPMENT ONLY ----------------------
# Set to 1 to open the admin dashboard with NO sign-in at all. Handy while
# building on your own machine; a serious data leak anywhere else, because
# anyone who can reach the server then reads every customer's name, email,
# phone and driving-licence number. IGNORED unless APP_URL is localhost.
# OPEN_ADMIN=1

# ------------------------ Network / security -------------------------
# Set to 0 when nothing sits in front of this process. When behind a
# reverse proxy (Hostinger, Railway, nginx) the proxy appends the real
# client IP to X-Forwarded-For; this tells the server to read it, so
# rate limiting keys on the real visitor rather than the proxy's egress
# address. Defaults to ON when NODE_ENV=production.
# TRUST_PROXY=1

# Addresses the demo seed (node db/seed-demo.js) files its bookings
# against. My Bookings looks a booking up by the SIGNED-IN address, so
# set these to accounts you can actually sign in with or the seeded
# page comes up empty. Comma separated, up to three.
# SEED_EMAILS=you@gmail.com,second@gmail.com
